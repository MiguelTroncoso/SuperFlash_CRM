{
  "name": "@superflash/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:verify-integrity": "tsx prisma/verify-integrity.ts",
    "prisma:verify-legacy": "tsx prisma/verify-legacy-commercial-data.ts",
    "prisma:refresh-revenue-views": "tsx prisma/refresh-revenue-views.ts",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/auth.security.spec.ts test/contacts.unit.spec.ts test/opportunities.unit.spec.ts test/followups.unit.spec.ts test/catalog.unit.spec.ts test/commercial.unit.spec.ts test/operations.unit.spec.ts test/automation.unit.spec.ts test/revenue-intelligence.unit.spec.ts test/whatsapp.unit.spec.ts test/communication.unit.spec.ts test/whatsapp-readonly.unit.spec.ts test/smart-inbox.unit.spec.ts test/financial.unit.spec.ts test/whatsapp-web-readonly.unit.spec.ts",
    "test:integration": "jest --runInBand test/auth.e2e-spec.ts test/contacts.e2e-spec.ts test/opportunities.e2e-spec.ts test/followups.e2e-spec.ts test/catalog.e2e-spec.ts test/commercial.e2e-spec.ts test/operations.e2e-spec.ts test/automation.e2e-spec.ts test/revenue-intelligence.e2e-spec.ts test/whatsapp.e2e-spec.ts test/smart-inbox.e2e-spec.ts test/financial.e2e-spec.ts test/whatsapp-web-readonly.e2e-spec.ts",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@superflash/utils": "0.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "libphonenumber-js": "^1.13.9",
    "luxon": "^3.7.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(e2e-)?spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "watchman": false
  }
}
