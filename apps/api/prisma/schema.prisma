generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PipelineStageCategory {
  OPEN
  WON
  LOST
}

enum ActivityType {
  MESSAGE
  NOTE
  DEMO
  FOLLOWUP
  PAYMENT
  SALE
  STATUS_CHANGE
  SYSTEM
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum FollowUpHistoryAction {
  CREATED
  UPDATED
  COMPLETED
  CANCELLED
  RESCHEDULED
  ASSIGNEE_CHANGED
  ARCHIVED
  RESTORED
}

enum SaleStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  TRANSFER
  PAYPAL
  BINANCE
  MERCADOPAGO
  STRIPE
  CASH
  MANUAL
  OTHER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  TRIAL
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum RenewalStatus {
  PENDING
  DUE
  OVERDUE
  PAID
  CANCELLED
}

enum RenewalWorkflowStatus {
  PENDING
  CONTACTED
  IN_CONVERSATION
  PAYMENT_PROMISE
  PAID
  RENEWED
  NOT_RENEWED
  CANCELLED
  LOST
}

enum RenewalReminderKind {
  DAYS_30
  DAYS_15
  DAYS_7
  DAYS_3
  DAYS_1
  DUE_TODAY
  OVERDUE_3
  OVERDUE_7
}

enum RenewalReminderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MessageTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MessageTemplateChannel {
  INTERNAL
  EMAIL
  WHATSAPP
  SMS
  PUSH
  WEBHOOK
}

enum AutomationTrigger {
  CONTACT_CREATED
  OPPORTUNITY_STAGE_CHANGED
  SALE_CONFIRMED
  PAYMENT_CONFIRMED
  TRIAL_EXPIRING
  TRIAL_EXPIRED
  SUBSCRIPTION_RENEWAL_DUE
  FULFILLMENT_COMPLETED
  ACTIVATION_CREATED
}

enum AutomationActionType {
  CREATE_TASK
  CREATE_NOTIFICATION
  ADD_ACTIVITY
  CREATE_FOLLOW_UP
  ENQUEUE_OUTBOX
  INTERNAL_WEBHOOK
}

enum AutomationExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AutomationActionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum WhatsAppConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  TEMPLATE
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACTS
  BUTTON
  INTERACTIVE
  UNKNOWN
}

enum WhatsAppMessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum CommunicationSyncChannel {
  WHATSAPP_READ_ONLY
  WHATSAPP_WEB_READ_ONLY
}

enum CommunicationSyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExpenseFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  ANNUAL
}

enum ExpensePaymentMethod {
  TRANSFER
  CARD
  CASH
  DIRECT_DEBIT
  OTHER
}

enum ProductType {
  SUBSCRIPTION
  CREDIT_PACKAGE
  LICENSE
  SERVICE
  DIGITAL_ACCESS
  OTHER
}

enum FulfillmentMode {
  MANUAL
  API
  INVITATION
  CREDENTIALS
  DOWNLOAD
  OTHER
}

enum CustomerSegment {
  END_CUSTOMER
  RESELLER
  SUPER_RESELLER
  ADMIN
  BUSINESS
  ANY
}

enum BillingPeriodUnit {
  DAY
  WEEK
  MONTH
  YEAR
  ONE_TIME
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PriceBookStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  DEGRADED
  SUSPENDED
}

enum ProviderType {
  MANUAL
  API
  PANEL
  INVENTORY
  DIGITAL_DELIVERY
  OTHER
}

enum ProviderFulfillmentMode {
  MANUAL
  AUTOMATIC
  HYBRID
  DIGITAL_DELIVERY
}

enum FulfillmentStatus {
  PENDING
  ASSIGNED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum FulfillmentExecutionMode {
  MANUAL
  AUTOMATIC
  HYBRID
  DIGITAL_DELIVERY
}

enum ProvisioningAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYABLE
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TrialStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
  FAILED
}

enum ActivationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  FAILED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                        User[]
  authSessions                 AuthSession[]
  passwordResetTokens          PasswordResetToken[]
  roles                        Role[]
  contacts                     Contact[]
  tags                         Tag[]
  contactTags                  ContactTag[]
  opportunities                Opportunity[]
  opportunityStageHistories    OpportunityStageHistory[]
  pipelineStages               PipelineStage[]
  activities                   Activity[]
  followUps                    FollowUp[]
  products                     Product[]
  productCategories            ProductCategory[]
  productPlans                 ProductPlan[]
  productVariants              ProductVariant[]
  priceBooks                   PriceBook[]
  priceBookEntries             PriceBookEntry[]
  priceHistories               PriceHistory[]
  sales                        Sale[]
  saleItems                    SaleItem[]
  payments                     Payment[]
  subscriptions                Subscription[]
  renewals                     Renewal[]
  renewalReminders             RenewalReminder[]
  campaigns                    Campaign[]
  expenses                     Expense[]
  auditLogs                    AuditLog[]
  followUpHistories            FollowUpHistory[]
  outboxEvents                 OutboxEvent[]
  providers                    Provider[]
  providerProductMappings      ProviderProductMapping[]
  fulfillments                 Fulfillment[]
  provisioningAttempts         ProvisioningAttempt[]
  credentialRecords            CredentialRecord[]
  trials                       Trial[]
  activations                  Activation[]
  messageTemplates             MessageTemplate[]
  automationRules              AutomationRule[]
  automationActions            AutomationAction[]
  automationExecutions         AutomationExecution[]
  automationActionRuns         AutomationExecutionAction[]
  notifications                Notification[]
  whatsappConnections          WhatsAppConnection[]
  whatsappPhoneNumbers         WhatsAppPhoneNumber[]
  whatsappConversations        WhatsAppConversation[]
  whatsappMessages             WhatsAppMessage[]
  whatsappWebhookEvents        WhatsAppWebhookEvent[]
  whatsappMessageStatuses      WhatsAppMessageStatus[]
  communicationSyncCheckpoints CommunicationSyncCheckpoint[]
  expenseCategories            ExpenseCategory[]
  recurringExpenses            RecurringExpense[]
  productStockMovements        ProductStockMovement[]

  @@index([createdAt])
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  permissions  Permission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([createdAt])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles Role[]

  @@index([createdAt])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  roleId         String     @db.Uuid
  email          String
  firstName      String
  lastName       String?
  phone          String?
  timezone       String     @default("America/Santiago")
  passwordHash   String?
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                          Role                      @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  contacts                      Contact[]                 @relation("ContactAssignee")
  opportunities                 Opportunity[]             @relation("OpportunityOwner")
  activities                    Activity[]                @relation("ActivityAuthor")
  followUps                     FollowUp[]                @relation("FollowUpResponsible")
  sales                         Sale[]                    @relation("SaleSeller")
  subscriptions                 Subscription[]            @relation("SubscriptionOwner")
  renewals                      Renewal[]                 @relation("RenewalOwner")
  renewalReminders              RenewalReminder[]
  campaigns                     Campaign[]                @relation("CampaignOwner")
  auditLogs                     AuditLog[]                @relation("AuditActor")
  outboxEvents                  OutboxEvent[]             @relation("OutboxActor")
  opportunityStageHistories     OpportunityStageHistory[] @relation("OpportunityStageHistoryActor")
  authSessions                  AuthSession[]
  passwordResetTokens           PasswordResetToken[]
  createdFollowUps              FollowUp[]                @relation("FollowUpCreatedBy")
  completedFollowUps            FollowUp[]                @relation("FollowUpCompletedBy")
  cancelledFollowUps            FollowUp[]                @relation("FollowUpCancelledBy")
  followUpHistories             FollowUpHistory[]         @relation("FollowUpHistoryActor")
  priceHistories                PriceHistory[]            @relation("PriceHistoryActor")
  assignedFulfillments          Fulfillment[]             @relation("FulfillmentAssignee")
  ownedTrials                   Trial[]                   @relation("TrialOwner")
  credentialReveals             CredentialRecord[]        @relation("CredentialRevealedBy")
  createdMessageTemplates       MessageTemplate[]         @relation("MessageTemplateCreator")
  createdAutomationRules        AutomationRule[]          @relation("AutomationRuleCreator")
  automationExecutions          AutomationExecution[]     @relation("AutomationExecutionActor")
  notifications                 Notification[]
  assignedWhatsAppConversations WhatsAppConversation[]    @relation("WhatsAppConversationAssignee")
  productStockMovements         ProductStockMovement[]    @relation("ProductStockMovementActor")

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  familyId         String    @db.Uuid
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model Contact {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String?   @db.Uuid
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  phoneNormalized String?
  country         String?
  source          String?
  notes           String?
  lastActivityAt  DateTime?
  isCustomer      Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo            User?                  @relation("ContactAssignee", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  tags                  ContactTag[]
  opportunities         Opportunity[]
  sales                 Sale[]
  subscriptions         Subscription[]
  activities            Activity[]
  trials                Trial[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // Partial uniqueness for active, non-null phones is defined in the SQL migration.
  @@index([organizationId, phoneNormalized])
  @@index([userId])
  @@index([phoneNormalized])
  @@index([country])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([source])
  @@index([archivedAt])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ContactTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdAt])
}

model ContactTag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  tagId          String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([contactId, tagId])
  @@index([organizationId])
  @@index([contactId])
  @@index([tagId])
  @@index([contactId, deletedAt])
  @@index([createdAt])
}

model Opportunity {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  contactId          String    @db.Uuid
  pipelineStageId    String    @db.Uuid
  campaignId         String?   @db.Uuid
  productId          String?   @db.Uuid
  userId             String?   @db.Uuid
  title              String
  notes              String?
  expectedAmount     Decimal?  @db.Decimal(14, 2)
  currency           String?
  closedAt           DateTime?
  archivedAt         DateTime?
  archiveReason      String?
  wonAt              DateTime?
  lastStageChangedAt DateTime?
  lostAt             DateTime?
  lostReason         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact       Contact                   @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  pipelineStage PipelineStage             @relation(fields: [organizationId, pipelineStageId], references: [organizationId, id], onDelete: Restrict)
  campaign      Campaign?                 @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  product       Product?                  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  owner         User?                     @relation("OpportunityOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  activities    Activity[]
  followUps     FollowUp[]
  sales         Sale[]
  stageHistory  OpportunityStageHistory[]
  trials        Trial[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([productId])
  @@index([pipelineStageId])
  @@index([contactId])
  @@index([organizationId, contactId, deletedAt])
  @@index([organizationId, pipelineStageId, deletedAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, lastStageChangedAt])
  @@index([organizationId, wonAt])
  @@index([organizationId, lostAt])
  @@index([userId])
  @@index([createdAt])
  @@index([closedAt])
}

model OpportunityStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  opportunityId   String   @db.Uuid
  fromStageId     String?  @db.Uuid
  toStageId       String   @db.Uuid
  changedByUserId String?  @db.Uuid
  reason          String?
  changedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity    @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  fromStage    PipelineStage? @relation("OpportunityStageHistoryFrom", fields: [organizationId, fromStageId], references: [organizationId, id], onDelete: Restrict)
  toStage      PipelineStage  @relation("OpportunityStageHistoryTo", fields: [organizationId, toStageId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?          @relation("OpportunityStageHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model PipelineStage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String
  order          Int
  color          String
  active         Boolean               @default(true)
  category       PipelineStageCategory
  systemKey      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities    Opportunity[]
  stageHistoryFrom OpportunityStageHistory[] @relation("OpportunityStageHistoryFrom")
  stageHistoryTo   OpportunityStageHistory[] @relation("OpportunityStageHistoryTo")

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, order])
  @@index([organizationId])
  @@index([organizationId, systemKey])
  @@index([category])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  contactId      String?      @db.Uuid
  opportunityId  String?      @db.Uuid
  saleId         String?      @db.Uuid
  followUpId     String?      @db.Uuid
  type           ActivityType
  title          String?
  description    String?
  occurredAt     DateTime     @default(now())
  metadata       Json?
  requestId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User?        @relation("ActivityAuthor", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  followUp     FollowUp?    @relation(fields: [organizationId, followUpId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([saleId])
  @@index([followUpId])
  @@index([organizationId, contactId, createdAt])
  @@index([createdAt])
}

model FollowUp {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  userId             String           @db.Uuid
  opportunityId      String           @db.Uuid
  title              String
  dueAt              DateTime
  priority           FollowUpPriority
  status             FollowUpStatus
  note               String?
  reminderAt         DateTime?
  rescheduledFromId  String?          @db.Uuid
  rescheduledAt      DateTime?
  completionNote     String?
  completedAt        DateTime?
  completedByUserId  String?          @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledByUserId  String?          @db.Uuid
  archivedAt         DateTime?
  createdByUserId    String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  responsible     User              @relation("FollowUpResponsible", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  opportunity     Opportunity       @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User?             @relation("FollowUpCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  completedBy     User?             @relation("FollowUpCompletedBy", fields: [organizationId, completedByUserId], references: [organizationId, id], onDelete: Restrict)
  cancelledBy     User?             @relation("FollowUpCancelledBy", fields: [organizationId, cancelledByUserId], references: [organizationId, id], onDelete: Restrict)
  rescheduledFrom FollowUp?         @relation("FollowUpReschedule", fields: [organizationId, rescheduledFromId], references: [organizationId, id], onDelete: Restrict)
  replacements    FollowUp[]        @relation("FollowUpReschedule")
  histories       FollowUpHistory[]
  activities      Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueAt])
  @@index([organizationId, dueAt])
  @@index([organizationId, userId, status, dueAt])
  @@index([organizationId, opportunityId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, priority, status])
  @@index([rescheduledFromId])
}

model FollowUpHistory {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  followUpId      String                @db.Uuid
  action          FollowUpHistoryAction
  changedByUserId String?               @db.Uuid
  previousDueAt   DateTime?
  newDueAt        DateTime?
  previousStatus  FollowUpStatus?
  newStatus       FollowUpStatus?
  note            String?
  metadata        Json?
  changedAt       DateTime              @default(now())
  createdAt       DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  followUp     FollowUp     @relation(fields: [organizationId, followUpId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?        @relation("FollowUpHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([followUpId])
  @@index([changedByUserId])
  @@index([action])
  @@index([changedAt])
}

model Product {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  categoryId            String?         @db.Uuid
  name                  String
  slug                  String
  sku                   String?
  description           String?
  type                  ProductType     @default(OTHER)
  fulfillmentMode       FulfillmentMode @default(MANUAL)
  status                ProductStatus   @default(DRAFT)
  active                Boolean         @default(true)
  requiresSubscription  Boolean         @default(false)
  allowsDemo            Boolean         @default(false)
  demoDurationHours     Int?
  requiresCustomerEmail Boolean         @default(false)
