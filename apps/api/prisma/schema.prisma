generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PipelineStageCategory {
  OPEN
  WON
  ARCHIVED
}

enum ActivityType {
  MESSAGE
  NOTE
  DEMO
  FOLLOWUP
  PAYMENT
  SALE
  STATUS_CHANGE
  SYSTEM
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum SaleStatus {
  OPEN
  WON
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users          User[]
  roles          Role[]
  contacts       Contact[]
  tags           Tag[]
  contactTags    ContactTag[]
  opportunities  Opportunity[]
  pipelineStages PipelineStage[]
  activities     Activity[]
  followUps      FollowUp[]
  products       Product[]
  sales          Sale[]
  saleItems      SaleItem[]
  payments       Payment[]
  campaigns      Campaign[]
  expenses       Expense[]
  auditLogs      AuditLog[]

  @@index([createdAt])
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  permissions  Permission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([createdAt])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles Role[]

  @@index([createdAt])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  roleId         String     @db.Uuid
  email          String
  firstName      String
  lastName       String?
  phone          String?
  passwordHash   String?
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role          Role          @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  contacts      Contact[]     @relation("ContactAssignee")
  opportunities Opportunity[] @relation("OpportunityOwner")
  activities    Activity[]    @relation("ActivityAuthor")
  followUps     FollowUp[]    @relation("FollowUpResponsible")
  sales         Sale[]        @relation("SaleSeller")
  campaigns     Campaign[]    @relation("CampaignOwner")
  auditLogs     AuditLog[]    @relation("AuditActor")

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model Contact {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String?   @db.Uuid
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  phoneNormalized String?
  country         String?
  source          String?
  notes           String?
  lastActivityAt  DateTime?
  isCustomer      Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo    User?         @relation("ContactAssignee", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  tags          ContactTag[]
  opportunities Opportunity[]
  activities    Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // Partial uniqueness for active, non-null phones is defined in the SQL migration.
  @@index([organizationId, phoneNormalized])
  @@index([userId])
  @@index([phoneNormalized])
  @@index([country])
  @@index([createdAt])
}

model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ContactTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([createdAt])
}

model ContactTag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  tagId          String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([contactId, tagId])
  @@index([organizationId])
  @@index([contactId])
  @@index([tagId])
  @@index([createdAt])
}

model Opportunity {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  contactId       String    @db.Uuid
  pipelineStageId String    @db.Uuid
  campaignId      String?   @db.Uuid
  productId       String?   @db.Uuid
  userId          String?   @db.Uuid
  title           String
  expectedAmount  Decimal?  @db.Decimal(14, 2)
  currency        String?
  closedAt        DateTime?
  archivedAt      DateTime?
  archiveReason   String?
  wonAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact       Contact       @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  pipelineStage PipelineStage @relation(fields: [organizationId, pipelineStageId], references: [organizationId, id], onDelete: Restrict)
  campaign      Campaign?     @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  product       Product?      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  owner         User?         @relation("OpportunityOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  activities    Activity[]
  followUps     FollowUp[]
  sales         Sale[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([productId])
  @@index([pipelineStageId])
  @@index([contactId])
  @@index([userId])
  @@index([createdAt])
  @@index([closedAt])
}

model PipelineStage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String
  order          Int
  color          String
  active         Boolean               @default(true)
  category       PipelineStageCategory
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, order])
  @@index([organizationId])
  @@index([category])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  contactId      String?      @db.Uuid
  opportunityId  String?      @db.Uuid
  saleId         String?      @db.Uuid
  type           ActivityType
  title          String?
  description    String?
  occurredAt     DateTime     @default(now())
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User?        @relation("ActivityAuthor", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([saleId])
  @@index([createdAt])
}

model FollowUp {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  opportunityId  String           @db.Uuid
  dueAt          DateTime
  priority       FollowUpPriority
  status         FollowUpStatus
  note           String?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  responsible  User         @relation("FollowUpResponsible", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueAt])
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  sku            String?
  description    String?
  category       String?
  billingType    String?
  durationDays   Int?
  price          Decimal   @db.Decimal(14, 2)
  currency       String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]
  saleItems     SaleItem[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // Partial uniqueness for active, non-null SKUs is defined in the SQL migration.
  @@index([organizationId, sku])
  @@index([active])
  @@index([createdAt])
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  opportunityId      String     @db.Uuid
  userId             String?    @db.Uuid
  status             SaleStatus
  subtotal           Decimal    @db.Decimal(14, 2)
  total              Decimal    @db.Decimal(14, 2)
  currency           String
  soldAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  note               String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  seller       User?        @relation("SaleSeller", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  items        SaleItem[]
  payments     Payment[]
  activities   Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // The active-sale uniqueness rule is defined as a partial SQL index.
  @@index([opportunityId])
  @@index([userId])
  @@index([status])
  @@index([soldAt])
  @@index([createdAt])
}

model SaleItem {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  saleId              String    @db.Uuid
  productId           String?   @db.Uuid
  productNameSnapshot String
  skuSnapshot         String?
  quantity            Decimal   @db.Decimal(14, 3)
  unitPrice           Decimal   @db.Decimal(14, 2)
  total               Decimal   @db.Decimal(14, 2)
  currency            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  product      Product?     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([saleId])
  @@index([productId])
  @@index([createdAt])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  saleId         String        @db.Uuid
  grossAmount    Decimal       @db.Decimal(14, 2)
  feeAmount      Decimal       @default(0) @db.Decimal(14, 2)
  netAmount      Decimal       @db.Decimal(14, 2)
  currency       String
  method         String
  reference      String?
  status         PaymentStatus
  paymentDate    DateTime
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([saleId])
  @@index([status])
  @@index([paymentDate])
  @@index([createdAt])
}

model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String?   @db.Uuid
  externalId     String?
  name           String
  source         String
  platform       String
  active         Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner         User?         @relation("CampaignOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  opportunities Opportunity[]
  expenses      Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@index([platform])
  @@index([active])
  @@index([createdAt])
}

model Expense {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  campaignId     String?   @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  expenseDate    DateTime
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  campaign     Campaign?    @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  tableName      String
  recordId       String
  previousValue  Json?
  newValue       Json?
  ip             String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation("AuditActor", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
}
