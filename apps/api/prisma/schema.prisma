  opportunities              Opportunity[]
  opportunityInterestHistory OpportunityInterestHistory[]
  saleItems                  SaleItem[]
  subscriptions              Subscription[]
  plans                      ProductPlan[]
  variants                   ProductVariant[]
  priceEntries               PriceBookEntry[]
  providerMappings           ProviderProductMapping[]
  trials                     Trial[]
  stockMovements             ProductStockMovement[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, slug])
  // Partial uniqueness for active, non-null SKUs is defined in SQL migrations.
  @@index([organizationId, sku])
  @@index([active])
  @@index([status])
  @@index([type])
  @@index([fulfillmentMode])
  @@index([createdAt])
}

