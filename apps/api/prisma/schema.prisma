generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PipelineStageCategory {
  OPEN
  WON
  LOST
}

enum ActivityType {
  MESSAGE
  NOTE
  DEMO
  FOLLOWUP
  PAYMENT
  SALE
  STATUS_CHANGE
  SYSTEM
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum FollowUpHistoryAction {
  CREATED
  UPDATED
  COMPLETED
  CANCELLED
  RESCHEDULED
  ASSIGNEE_CHANGED
  ARCHIVED
  RESTORED
}

enum SaleStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  TRANSFER
  PAYPAL
  BINANCE
  MERCADOPAGO
  STRIPE
  CASH
  MANUAL
  OTHER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  TRIAL
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum RenewalStatus {
  PENDING
  DUE
  OVERDUE
  PAID
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProductType {
  SUBSCRIPTION
  CREDIT_PACKAGE
  LICENSE
  SERVICE
  DIGITAL_ACCESS
  OTHER
}

enum FulfillmentMode {
  MANUAL
  API
  INVITATION
  CREDENTIALS
  DOWNLOAD
  OTHER
}

enum CustomerSegment {
  END_CUSTOMER
  RESELLER
  SUPER_RESELLER
  ADMIN
  BUSINESS
  ANY
}

enum BillingPeriodUnit {
  DAY
  WEEK
  MONTH
  YEAR
  ONE_TIME
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PriceBookStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                     User[]
  authSessions              AuthSession[]
  passwordResetTokens       PasswordResetToken[]
  roles                     Role[]
  contacts                  Contact[]
  tags                      Tag[]
  contactTags               ContactTag[]
  opportunities             Opportunity[]
  opportunityStageHistories OpportunityStageHistory[]
  pipelineStages            PipelineStage[]
  activities                Activity[]
  followUps                 FollowUp[]
  products                  Product[]
  productCategories         ProductCategory[]
  productPlans              ProductPlan[]
  productVariants           ProductVariant[]
  priceBooks                PriceBook[]
  priceBookEntries          PriceBookEntry[]
  priceHistories            PriceHistory[]
  sales                     Sale[]
  saleItems                 SaleItem[]
  payments                  Payment[]
  subscriptions             Subscription[]
  renewals                  Renewal[]
  campaigns                 Campaign[]
  expenses                  Expense[]
  auditLogs                 AuditLog[]
  followUpHistories         FollowUpHistory[]
  outboxEvents              OutboxEvent[]

  @@index([createdAt])
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  permissions  Permission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([createdAt])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles Role[]

  @@index([createdAt])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  roleId         String     @db.Uuid
  email          String
  firstName      String
  lastName       String?
  phone          String?
  passwordHash   String?
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                      Role                      @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  contacts                  Contact[]                 @relation("ContactAssignee")
  opportunities             Opportunity[]             @relation("OpportunityOwner")
  activities                Activity[]                @relation("ActivityAuthor")
  followUps                 FollowUp[]                @relation("FollowUpResponsible")
  sales                     Sale[]                    @relation("SaleSeller")
  subscriptions             Subscription[]            @relation("SubscriptionOwner")
  renewals                  Renewal[]                 @relation("RenewalOwner")
  campaigns                 Campaign[]                @relation("CampaignOwner")
  auditLogs                 AuditLog[]                @relation("AuditActor")
  outboxEvents              OutboxEvent[]             @relation("OutboxActor")
  opportunityStageHistories OpportunityStageHistory[] @relation("OpportunityStageHistoryActor")
  authSessions              AuthSession[]
  passwordResetTokens       PasswordResetToken[]
  createdFollowUps          FollowUp[]                @relation("FollowUpCreatedBy")
  completedFollowUps        FollowUp[]                @relation("FollowUpCompletedBy")
  cancelledFollowUps        FollowUp[]                @relation("FollowUpCancelledBy")
  followUpHistories         FollowUpHistory[]         @relation("FollowUpHistoryActor")
  priceHistories            PriceHistory[]            @relation("PriceHistoryActor")

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  familyId         String    @db.Uuid
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model Contact {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String?   @db.Uuid
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  phoneNormalized String?
  country         String?
  source          String?
  notes           String?
  lastActivityAt  DateTime?
  isCustomer      Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo    User?          @relation("ContactAssignee", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  tags          ContactTag[]
  opportunities Opportunity[]
  sales         Sale[]
  subscriptions Subscription[]
  activities    Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // Partial uniqueness for active, non-null phones is defined in the SQL migration.
  @@index([organizationId, phoneNormalized])
  @@index([userId])
  @@index([phoneNormalized])
  @@index([country])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([source])
  @@index([archivedAt])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ContactTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdAt])
}

model ContactTag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  tagId          String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([contactId, tagId])
  @@index([organizationId])
  @@index([contactId])
  @@index([tagId])
  @@index([contactId, deletedAt])
  @@index([createdAt])
}

model Opportunity {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  contactId          String    @db.Uuid
  pipelineStageId    String    @db.Uuid
  campaignId         String?   @db.Uuid
  productId          String?   @db.Uuid
  userId             String?   @db.Uuid
  title              String
  notes              String?
  expectedAmount     Decimal?  @db.Decimal(14, 2)
  currency           String?
  closedAt           DateTime?
  archivedAt         DateTime?
  archiveReason      String?
  wonAt              DateTime?
  lastStageChangedAt DateTime?
  lostAt             DateTime?
  lostReason         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact       Contact                   @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  pipelineStage PipelineStage             @relation(fields: [organizationId, pipelineStageId], references: [organizationId, id], onDelete: Restrict)
  campaign      Campaign?                 @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  product       Product?                  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  owner         User?                     @relation("OpportunityOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  activities    Activity[]
  followUps     FollowUp[]
  sales         Sale[]
  stageHistory  OpportunityStageHistory[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([productId])
  @@index([pipelineStageId])
  @@index([contactId])
  @@index([organizationId, contactId, deletedAt])
  @@index([organizationId, pipelineStageId, deletedAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, lastStageChangedAt])
  @@index([organizationId, wonAt])
  @@index([organizationId, lostAt])
  @@index([userId])
  @@index([createdAt])
  @@index([closedAt])
}

model OpportunityStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  opportunityId   String   @db.Uuid
  fromStageId     String?  @db.Uuid
  toStageId       String   @db.Uuid
  changedByUserId String?  @db.Uuid
  reason          String?
  changedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity    @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  fromStage    PipelineStage? @relation("OpportunityStageHistoryFrom", fields: [organizationId, fromStageId], references: [organizationId, id], onDelete: Restrict)
  toStage      PipelineStage  @relation("OpportunityStageHistoryTo", fields: [organizationId, toStageId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?          @relation("OpportunityStageHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model PipelineStage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String
  order          Int
  color          String
  active         Boolean               @default(true)
  category       PipelineStageCategory
  systemKey      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities    Opportunity[]
  stageHistoryFrom OpportunityStageHistory[] @relation("OpportunityStageHistoryFrom")
  stageHistoryTo   OpportunityStageHistory[] @relation("OpportunityStageHistoryTo")

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, order])
  @@index([organizationId])
  @@index([organizationId, systemKey])
  @@index([category])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  contactId      String?      @db.Uuid
  opportunityId  String?      @db.Uuid
  saleId         String?      @db.Uuid
  followUpId     String?      @db.Uuid
  type           ActivityType
  title          String?
  description    String?
  occurredAt     DateTime     @default(now())
  metadata       Json?
  requestId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User?        @relation("ActivityAuthor", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  followUp     FollowUp?    @relation(fields: [organizationId, followUpId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([saleId])
  @@index([followUpId])
  @@index([organizationId, contactId, createdAt])
  @@index([createdAt])
}

model FollowUp {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  userId             String           @db.Uuid
  opportunityId      String           @db.Uuid
  title              String
  dueAt              DateTime
  priority           FollowUpPriority
  status             FollowUpStatus
  note               String?
  reminderAt         DateTime?
  rescheduledFromId  String?          @db.Uuid
  rescheduledAt      DateTime?
  completionNote     String?
  completedAt        DateTime?
  completedByUserId  String?          @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledByUserId  String?          @db.Uuid
  archivedAt         DateTime?
  createdByUserId    String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  responsible     User              @relation("FollowUpResponsible", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  opportunity     Opportunity       @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User?             @relation("FollowUpCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  completedBy     User?             @relation("FollowUpCompletedBy", fields: [organizationId, completedByUserId], references: [organizationId, id], onDelete: Restrict)
  cancelledBy     User?             @relation("FollowUpCancelledBy", fields: [organizationId, cancelledByUserId], references: [organizationId, id], onDelete: Restrict)
  rescheduledFrom FollowUp?         @relation("FollowUpReschedule", fields: [organizationId, rescheduledFromId], references: [organizationId, id], onDelete: Restrict)
  replacements    FollowUp[]        @relation("FollowUpReschedule")
  histories       FollowUpHistory[]
  activities      Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueAt])
  @@index([organizationId, dueAt])
  @@index([organizationId, userId, status, dueAt])
  @@index([organizationId, opportunityId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, priority, status])
  @@index([rescheduledFromId])
}

model FollowUpHistory {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  followUpId      String                @db.Uuid
  action          FollowUpHistoryAction
  changedByUserId String?               @db.Uuid
  previousDueAt   DateTime?
  newDueAt        DateTime?
  previousStatus  FollowUpStatus?
  newStatus       FollowUpStatus?
  note            String?
  metadata        Json?
  changedAt       DateTime              @default(now())
  createdAt       DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  followUp     FollowUp     @relation(fields: [organizationId, followUpId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?        @relation("FollowUpHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([followUpId])
  @@index([changedByUserId])
  @@index([action])
  @@index([changedAt])
}

model Product {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  categoryId            String?         @db.Uuid
  name                  String
  slug                  String
  sku                   String?
  description           String?
  type                  ProductType     @default(OTHER)
  fulfillmentMode       FulfillmentMode @default(MANUAL)
  status                ProductStatus   @default(DRAFT)
  active                Boolean         @default(true)
  requiresSubscription  Boolean         @default(false)
  allowsDemo            Boolean         @default(false)
  demoDurationHours     Int?
  requiresCustomerEmail Boolean         @default(false)
  requiresCustomerPhone Boolean         @default(false)
  requiresManualReview  Boolean         @default(false)
  metadata              Json?

  // Deprecated compatibility fields retained for existing opportunity/sale fixtures.
  category     String?
  billingType  String?
  durationDays Int?
  price        Decimal?  @default(0) @db.Decimal(14, 2)
  currency     String?   @default("USD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productCategory ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  opportunities   Opportunity[]
  saleItems       SaleItem[]
  subscriptions   Subscription[]
  plans           ProductPlan[]
  variants        ProductVariant[]
  priceEntries    PriceBookEntry[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, slug])
  // Partial uniqueness for active, non-null SKUs is defined in SQL migrations.
  @@index([organizationId, sku])
  @@index([active])
  @@index([status])
  @@index([type])
  @@index([fulfillmentMode])
  @@index([createdAt])
}

model ProductCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  active         Boolean   @default(true)
  order          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([organizationId, order])
  @@index([active])
  @@index([createdAt])
}

model ProductPlan {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  productId          String            @db.Uuid
  name               String
  code               String?
  description        String?
  customerSegment    CustomerSegment
  billingPeriodUnit  BillingPeriodUnit
  billingPeriodCount Int               @default(1)
  quantity           Decimal?          @db.Decimal(18, 3)
  deviceLimit        Int?
  creditAmount       Decimal?          @db.Decimal(18, 3)
  active             Boolean           @default(true)
  order              Int
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  variants      ProductVariant[]
  priceEntries  PriceBookEntry[]
  saleItems     SaleItem[]
  subscriptions Subscription[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId, id])
  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId, order])
  @@index([customerSegment])
  @@index([active])
  @@index([createdAt])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  productId      String    @db.Uuid
  planId         String?   @db.Uuid
  name           String
  code           String?
  attributes     Json
  active         Boolean   @default(true)
  order          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  plan          ProductPlan?     @relation(fields: [organizationId, productId, planId], references: [organizationId, productId, id], onDelete: Restrict)
  priceEntries  PriceBookEntry[]
  saleItems     SaleItem[]
  subscriptions Subscription[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId, id])
  @@index([organizationId])
  @@index([productId])
  @@index([planId])
  @@index([organizationId, productId, order])
  @@index([active])
  @@index([createdAt])
}

model PriceBook {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  name            String
  description     String?
  status          PriceBookStatus
  customerSegment CustomerSegment
  countryCode     String?
  currency        String
  validFrom       DateTime?
  validUntil      DateTime?
  isDefault       Boolean         @default(false)
  priority        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries      PriceBookEntry[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status])
  @@index([customerSegment])
  @@index([countryCode])
  @@index([currency])
  @@index([validFrom, validUntil])
  @@index([createdAt])
}

model PriceBookEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  priceBookId    String    @db.Uuid
  productId      String    @db.Uuid
  planId         String?   @db.Uuid
  variantId      String?   @db.Uuid
  salePrice      Decimal   @db.Decimal(18, 2)
  costPrice      Decimal?  @db.Decimal(18, 2)
  minimumPrice   Decimal?  @db.Decimal(18, 2)
  taxIncluded    Boolean   @default(false)
  active         Boolean   @default(true)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priceBook    PriceBook       @relation(fields: [organizationId, priceBookId], references: [organizationId, id], onDelete: Restrict)
  product      Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  plan         ProductPlan?    @relation(fields: [organizationId, productId, planId], references: [organizationId, productId, id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [organizationId, productId, variantId], references: [organizationId, productId, id], onDelete: Restrict)
  histories    PriceHistory[]
  saleItems    SaleItem[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([priceBookId])
  @@index([productId])
  @@index([planId])
  @@index([variantId])
  @@index([active])
  @@index([validFrom, validUntil])
  @@index([createdAt])
}

model PriceHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  priceBookEntryId     String   @db.Uuid
  changedByUserId      String?  @db.Uuid
  previousSalePrice    Decimal? @db.Decimal(18, 2)
  newSalePrice         Decimal? @db.Decimal(18, 2)
  previousCostPrice    Decimal? @db.Decimal(18, 2)
  newCostPrice         Decimal? @db.Decimal(18, 2)
  previousMinimumPrice Decimal? @db.Decimal(18, 2)
  newMinimumPrice      Decimal? @db.Decimal(18, 2)
  reason               String?
  changedAt            DateTime @default(now())
  createdAt            DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priceBookEntry PriceBookEntry @relation(fields: [organizationId, priceBookEntryId], references: [organizationId, id], onDelete: Restrict)
  changedBy      User?          @relation("PriceHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([priceBookEntryId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  contactId          String     @db.Uuid
  opportunityId      String?    @db.Uuid
  userId             String?    @db.Uuid
  status             SaleStatus
  subtotal           Decimal    @db.Decimal(18, 2)
  discountAmount     Decimal    @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal    @default(0) @db.Decimal(18, 2)
  total              Decimal    @db.Decimal(18, 2)
  currency           String
  soldAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  note               String?
  version            Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact       Contact        @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  opportunity   Opportunity?   @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  seller        User?          @relation("SaleSeller", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  renewalFrom   Renewal?       @relation("RenewalGeneratedSale")
  renewalItems  Renewal[]      @relation("RenewalSourceSale")
  subscriptions Subscription[]
  items         SaleItem[]
  payments      Payment[]
  activities    Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, opportunityId])
  @@index([organizationId, contactId])
  @@index([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, currency])
  @@index([soldAt])
  @@index([createdAt])
}

model SaleItem {
  id                           String             @id @default(uuid()) @db.Uuid
  organizationId               String             @db.Uuid
  saleId                       String             @db.Uuid
  productId                    String?            @db.Uuid
  planId                       String?            @db.Uuid
  variantId                    String?            @db.Uuid
  priceBookEntryId             String?            @db.Uuid
  snapshotVersion              Int                @default(2)
  productNameSnapshot          String
  productSlugSnapshot          String?
  productTypeSnapshot          ProductType?
  fulfillmentModeSnapshot      FulfillmentMode?
  requiresSubscriptionSnapshot Boolean            @default(false)
  skuSnapshot                  String?
  planNameSnapshot             String?
  variantNameSnapshot          String?
  billingPeriodUnitSnapshot    BillingPeriodUnit?
  billingPeriodCountSnapshot   Int?
  catalogSnapshot              Json
  quantity                     Decimal            @db.Decimal(18, 3)
  unitPrice                    Decimal            @db.Decimal(18, 2)
  discountAmount               Decimal            @default(0) @db.Decimal(18, 2)
  taxAmount                    Decimal            @default(0) @db.Decimal(18, 2)
  total                        Decimal            @db.Decimal(18, 2)
  currency                     String
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  deletedAt                    DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale           Sale            @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  product        Product?        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  plan           ProductPlan?    @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  priceBookEntry PriceBookEntry? @relation(fields: [organizationId, priceBookEntryId], references: [organizationId, id], onDelete: Restrict)
  subscription   Subscription?

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, saleId])
  @@index([organizationId, productId])
  @@index([organizationId, planId])
  @@index([organizationId, variantId])
  @@index([createdAt])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  saleId             String        @db.Uuid
  grossAmount        Decimal       @db.Decimal(18, 2)
  feeAmount          Decimal       @default(0) @db.Decimal(18, 2)
  netAmount          Decimal       @db.Decimal(18, 2)
  refundedAmount     Decimal       @default(0) @db.Decimal(18, 2)
  currency           String
  method             PaymentMethod
  reference          String?
  idempotencyKey     String?
  requestFingerprint String?
  status             PaymentStatus
  paymentDate        DateTime      @default(now())
  confirmedAt        DateTime?
  failedAt           DateTime?
  refundedAt         DateTime?
  refundReason       String?
  note               String?
  metadata           Json?
  version            Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale         @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, saleId])
  @@index([organizationId, status])
  @@index([paymentDate])
  @@index([createdAt])
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  saleId              String             @db.Uuid
  saleItemId          String             @db.Uuid
  contactId           String             @db.Uuid
  userId              String?            @db.Uuid
  productId           String?            @db.Uuid
  planId              String?            @db.Uuid
  variantId           String?            @db.Uuid
  snapshotVersion     Int                @default(2)
  status              SubscriptionStatus @default(PENDING)
  billingCycle        BillingCycle
  customIntervalDays  Int?
  currency            String
  amount              Decimal            @db.Decimal(18, 2)
  quantity            Decimal            @default(1) @db.Decimal(18, 3)
  productNameSnapshot String
  skuSnapshot         String?
  planNameSnapshot    String?
  variantNameSnapshot String?
  catalogSnapshot     Json
  startsAt            DateTime
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  nextBillingAt       DateTime?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  expiredAt           DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  version             Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         Sale            @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  saleItem     SaleItem        @relation(fields: [organizationId, saleItemId], references: [organizationId, id], onDelete: Restrict)
  contact      Contact         @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  owner        User?           @relation("SubscriptionOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  product      Product?        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  plan         ProductPlan?    @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  renewals     Renewal[]

  @@unique([organizationId, id])
  @@unique([organizationId, saleItemId])
  @@index([organizationId])
  @@index([organizationId, saleId])
  @@index([organizationId, contactId])
  @@index([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, nextBillingAt])
  @@index([createdAt])
}

model Renewal {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  subscriptionId      String        @db.Uuid
  sourceSaleId        String        @db.Uuid
  generatedSaleId     String?       @db.Uuid
  userId              String?       @db.Uuid
  status              RenewalStatus @default(PENDING)
  billingCycle        BillingCycle
  customIntervalDays  Int?
  amount              Decimal       @db.Decimal(18, 2)
  currency            String
  dueAt               DateTime
  periodStart         DateTime
  periodEnd           DateTime
  cycleKey            String
  paidAt              DateTime?
  snapshotVersion     Int           @default(2)
  productNameSnapshot String
  skuSnapshot         String?
  catalogSnapshot     Json
  notes               String?
  version             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription  Subscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)
  sourceSale    Sale         @relation("RenewalSourceSale", fields: [organizationId, sourceSaleId], references: [organizationId, id], onDelete: Restrict)
  generatedSale Sale?        @relation("RenewalGeneratedSale", fields: [organizationId, generatedSaleId], references: [organizationId, id], onDelete: Restrict)
  owner         User?        @relation("RenewalOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, generatedSaleId])
  @@unique([organizationId, subscriptionId, cycleKey])
  @@index([organizationId])
  @@index([organizationId, subscriptionId])
  @@index([organizationId, sourceSaleId])
  @@index([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, dueAt])
  @@index([createdAt])
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  eventType      String
  organizationId String            @db.Uuid
  aggregateType  String
  aggregateId    String            @db.Uuid
  actorId        String?           @db.Uuid
  requestId      String
  occurredAt     DateTime
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now())
  processingAt   DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("OutboxActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([status, availableAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([requestId])
  @@index([createdAt])
}

model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String?   @db.Uuid
  externalId     String?
  name           String
  source         String
  platform       String
  active         Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner         User?         @relation("CampaignOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  opportunities Opportunity[]
  expenses      Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@index([platform])
  @@index([active])
  @@index([createdAt])
}

model Expense {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  campaignId     String?   @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  expenseDate    DateTime
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  campaign     Campaign?    @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String
  tableName      String
  recordId       String
  previousValue  Json?
  newValue       Json?
  ip             String?
  requestId      String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation("AuditActor", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
}
