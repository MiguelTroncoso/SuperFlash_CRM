  slug                  String
  sku                   String?
  description           String?
  type                  ProductType     @default(OTHER)
  fulfillmentMode       FulfillmentMode @default(MANUAL)
  status                ProductStatus   @default(DRAFT)
  active                Boolean         @default(true)
  requiresSubscription  Boolean         @default(false)
  allowsDemo            Boolean         @default(false)
  demoDurationHours     Int?
