model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  saleSequence Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users                        User[]
  authSessions                 AuthSession[]
  passwordResetTokens          PasswordResetToken[]
  roles                        Role[]
  contacts                     Contact[]
  tags                         Tag[]
  contactTags                  ContactTag[]
  opportunities                Opportunity[]
  opportunityStageHistories    OpportunityStageHistory[]
  opportunityInterestHistory   OpportunityInterestHistory[]
  pipelineStages               PipelineStage[]
  activities                   Activity[]
  followUps                    FollowUp[]
  products                     Product[]
  productCategories            ProductCategory[]
  productPlans                 ProductPlan[]
  productVariants              ProductVariant[]
  priceBooks                   PriceBook[]
  priceBookEntries             PriceBookEntry[]
  priceHistories               PriceHistory[]
  sales                        Sale[]
  saleItems                    SaleItem[]
  payments                     Payment[]
  subscriptions                Subscription[]
  renewals                     Renewal[]
  renewalReminders             RenewalReminder[]
  campaigns                    Campaign[]
  dailyMetrics                 DailyMetric[]
  expenses                     Expense[]
  marketingAdSets              MarketingAdSet[]
  marketingAds                 MarketingAd[]
  marketingCreatives           MarketingCreative[]
  attributions                 Attribution[]
  prospectConversationStates   ProspectConversationState[]
  prospectConversationHistory  ProspectConversationStateHistory[]
  lossReasons                  LossReason[]
  prospectReasons              ProspectReason[]
  prospectEngagementConfigs    ProspectEngagementConfig[]
  commercialImports            CommercialImport[]
  commercialImportRows         CommercialImportRow[]
  auditLogs                    AuditLog[]
  followUpHistories            FollowUpHistory[]
  outboxEvents                 OutboxEvent[]
  providers                    Provider[]
  providerProductMappings      ProviderProductMapping[]
  fulfillments                 Fulfillment[]
  provisioningAttempts         ProvisioningAttempt[]
  credentialRecords            CredentialRecord[]
  trials                       Trial[]
  activations                  Activation[]
  messageTemplates             MessageTemplate[]
  automationRules              AutomationRule[]
  automationActions            AutomationAction[]
  automationExecutions         AutomationExecution[]
  automationActionRuns         AutomationExecutionAction[]
  notifications                Notification[]
  whatsappConnections          WhatsAppConnection[]
  whatsappPhoneNumbers         WhatsAppPhoneNumber[]
  whatsappConversations        WhatsAppConversation[]
  whatsappMessages             WhatsAppMessage[]
  whatsappWebhookEvents        WhatsAppWebhookEvent[]
  whatsappMessageStatuses      WhatsAppMessageStatus[]
  communicationSyncCheckpoints CommunicationSyncCheckpoint[]
  expenseCategories            ExpenseCategory[]
  recurringExpenses            RecurringExpense[]
  productStockMovements        ProductStockMovement[]
  paymentFeeConfigs            PaymentFeeConfig[]

  @@index([createdAt])
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  permissions  Permission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([createdAt])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles Role[]

  @@index([createdAt])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  roleId         String     @db.Uuid
  email          String
  firstName      String
  lastName       String?
  phone          String?
  timezone       String     @default("America/Santiago")
  passwordHash   String?
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization                  Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                          Role                               @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  contacts                      Contact[]                          @relation("ContactAssignee")
  opportunities                 Opportunity[]                      @relation("OpportunityOwner")
  activities                    Activity[]                         @relation("ActivityAuthor")
  followUps                     FollowUp[]                         @relation("FollowUpResponsible")
  sales                         Sale[]                             @relation("SaleSeller")
  subscriptions                 Subscription[]                     @relation("SubscriptionOwner")
  renewals                      Renewal[]                          @relation("RenewalOwner")
  renewalReminders              RenewalReminder[]
  campaigns                     Campaign[]                         @relation("CampaignOwner")
  createdDailyMetrics           DailyMetric[]                      @relation("DailyMetricCreator")
  updatedDailyMetrics           DailyMetric[]                      @relation("DailyMetricUpdater")
  createdAttributions           Attribution[]                      @relation("AttributionCreator")
  correctedAttributions         Attribution[]                      @relation("AttributionCorrector")
  prospectStatesChanged         ProspectConversationState[]        @relation("ProspectStateActor")
  prospectStateChanges          ProspectConversationStateHistory[] @relation("ProspectStateHistoryActor")
  prospectReasons               ProspectReason[]                   @relation("ProspectReasonActor")
  commercialImports             CommercialImport[]                 @relation("CommercialImportCreator")
  createdExpenses               Expense[]                          @relation("ExpenseCreator")
  auditLogs                     AuditLog[]                         @relation("AuditActor")
  outboxEvents                  OutboxEvent[]                      @relation("OutboxActor")
  opportunityStageHistories     OpportunityStageHistory[]          @relation("OpportunityStageHistoryActor")
  opportunityInterestHistory    OpportunityInterestHistory[]       @relation("OpportunityInterestHistoryActor")
  authSessions                  AuthSession[]
  passwordResetTokens           PasswordResetToken[]
  createdFollowUps              FollowUp[]                         @relation("FollowUpCreatedBy")
  completedFollowUps            FollowUp[]                         @relation("FollowUpCompletedBy")
  cancelledFollowUps            FollowUp[]                         @relation("FollowUpCancelledBy")
  followUpHistories             FollowUpHistory[]                  @relation("FollowUpHistoryActor")
  priceHistories                PriceHistory[]                     @relation("PriceHistoryActor")
  assignedFulfillments          Fulfillment[]                      @relation("FulfillmentAssignee")
  ownedTrials                   Trial[]                            @relation("TrialOwner")
  credentialReveals             CredentialRecord[]                 @relation("CredentialRevealedBy")
  createdMessageTemplates       MessageTemplate[]                  @relation("MessageTemplateCreator")
  createdAutomationRules        AutomationRule[]                   @relation("AutomationRuleCreator")
  automationExecutions          AutomationExecution[]              @relation("AutomationExecutionActor")
  notifications                 Notification[]
  assignedWhatsAppConversations WhatsAppConversation[]             @relation("WhatsAppConversationAssignee")
  productStockMovements         ProductStockMovement[]             @relation("ProductStockMovementActor")

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  familyId         String    @db.Uuid
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model Contact {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String?   @db.Uuid
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  phoneNormalized String?
  country         String?
  source          String?
  notes           String?
  lastActivityAt  DateTime?
  isCustomer      Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization          Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo            User?                              @relation("ContactAssignee", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  tags                  ContactTag[]
  opportunities         Opportunity[]
  sales                 Sale[]
  subscriptions         Subscription[]
  activities            Activity[]
  trials                Trial[]
  attributions          Attribution[]
  prospectState         ProspectConversationState?
  prospectStateHistory  ProspectConversationStateHistory[]
  prospectReasons       ProspectReason[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]

  @@unique([organizationId, id])
  @@index([organizationId])
  // Partial uniqueness for active, non-null phones is defined in the SQL migration.
  @@index([organizationId, phoneNormalized])
  @@index([userId])
  @@index([phoneNormalized])
  @@index([country])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([source])
  @@index([archivedAt])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ContactTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdAt])
}

model ContactTag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  tagId          String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([contactId, tagId])
  @@index([organizationId])
  @@index([contactId])
  @@index([tagId])
  @@index([contactId, deletedAt])
  @@index([createdAt])
}

model Opportunity {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  contactId           String              @db.Uuid
  pipelineStageId     String              @db.Uuid
  campaignId          String?             @db.Uuid
  categoryId          String?             @db.Uuid
  productId           String?             @db.Uuid
  userId              String?             @db.Uuid
  title               String
  notes               String?
  expectedAmount      Decimal?            @db.Decimal(14, 2)
  currency            String?
  estimatedPurchaseAt DateTime?
  probability         Int                 @default(50)
  priority            OpportunityPriority @default(NORMAL)
  closedAt            DateTime?
  archivedAt          DateTime?
  archiveReason       String?
  wonAt               DateTime?
  lastStageChangedAt  DateTime?
  lostAt              DateTime?
  lostReason          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact         Contact                      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  pipelineStage   PipelineStage                @relation(fields: [organizationId, pipelineStageId], references: [organizationId, id], onDelete: Restrict)
  campaign        Campaign?                    @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  category        ProductCategory?             @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  product         Product?                     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  owner           User?                        @relation("OpportunityOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  activities      Activity[]
  followUps       FollowUp[]
  sales           Sale[]
  stageHistory    OpportunityStageHistory[]
  trials          Trial[]
  attributions    Attribution[]
  prospectReasons ProspectReason[]
  interestHistory OpportunityInterestHistory[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([organizationId, categoryId])
  @@index([productId])
  @@index([pipelineStageId])
  @@index([contactId])
  @@index([organizationId, contactId, deletedAt])
  @@index([organizationId, pipelineStageId, deletedAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, lastStageChangedAt])
  @@index([organizationId, wonAt])
  @@index([organizationId, lostAt])
  @@index([organizationId, priority, deletedAt])
  @@index([organizationId, probability, deletedAt])
  @@index([userId])
  @@index([createdAt])
  @@index([closedAt])
}

model OpportunityInterestHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  opportunityId   String   @db.Uuid
  categoryId      String?  @db.Uuid
  productId       String?  @db.Uuid
  changedByUserId String?  @db.Uuid
  reason          String?
  createdAt       DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity      @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  category     ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  product      Product?         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?            @relation("OpportunityInterestHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, opportunityId, createdAt])
  @@index([organizationId, categoryId, createdAt])
  @@index([organizationId, productId, createdAt])
}

model OpportunityStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  opportunityId   String   @db.Uuid
  fromStageId     String?  @db.Uuid
  toStageId       String   @db.Uuid
  changedByUserId String?  @db.Uuid
  reason          String?
  changedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity    @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  fromStage    PipelineStage? @relation("OpportunityStageHistoryFrom", fields: [organizationId, fromStageId], references: [organizationId, id], onDelete: Restrict)
  toStage      PipelineStage  @relation("OpportunityStageHistoryTo", fields: [organizationId, toStageId], references: [organizationId, id], onDelete: Restrict)
  changedBy    User?          @relation("OpportunityStageHistoryActor", fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model PipelineStage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String
  order          Int
  color          String
  active         Boolean               @default(true)
  category       PipelineStageCategory
  systemKey      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities    Opportunity[]
  stageHistoryFrom OpportunityStageHistory[] @relation("OpportunityStageHistoryFrom")
  stageHistoryTo   OpportunityStageHistory[] @relation("OpportunityStageHistoryTo")

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, order])
  @@index([organizationId])
  @@index([organizationId, systemKey])
  @@index([category])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
