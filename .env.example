NODE_ENV=development

API_PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql://superflash:superflash@localhost:5432/superflash?schema=public
REDIS_URL=redis://localhost:6379

MAIL_HOST=localhost
MAIL_PORT=1025

NEXT_PUBLIC_API_URL=http://localhost:3001

# In production this must be a unique secret with at least 32 characters.
JWT_ACCESS_SECRET=change-this-development-secret-before-production-1234567890
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
SWAGGER_ENABLED=true
DEFAULT_TIMEZONE=America/Santiago

# Used to encrypt credential values at rest. Use a unique secret with at least 32 characters in production.
CREDENTIAL_ENCRYPTION_KEY=change-this-development-credential-key-before-production-1234567890
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_WEBHOOK_PUBLIC_URL=http://localhost:3001/api/v1/integrations/whatsapp/webhook

# Optional development Owner seed. Leave empty to skip user creation.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=
SEED_OWNER_LAST_NAME=

# Optional development-only catalog examples (never enabled in production).
SEED_CATALOG_EXAMPLES=false
