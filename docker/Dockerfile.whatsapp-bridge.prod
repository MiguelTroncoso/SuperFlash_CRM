FROM node:22-alpine AS dependencies

RUN apk add --no-cache libc6-compat openssl python3 make g++
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/whatsapp-bridge/package.json ./apps/whatsapp-bridge/package.json
RUN HUSKY=0 npm ci --workspace=@superflash/whatsapp-bridge --include-workspace-root

FROM dependencies AS builder
COPY tsconfig.base.json ./tsconfig.base.json
COPY apps/whatsapp-bridge ./apps/whatsapp-bridge
RUN npm run build --workspace=@superflash/whatsapp-bridge

FROM node:22-alpine AS runner
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
ENV NODE_ENV=production
ENV WHATSAPP_BRIDGE_PORT=3020
COPY --from=dependencies --chown=app:app /app/node_modules ./node_modules
COPY --from=dependencies --chown=app:app /app/package.json ./package.json
COPY --from=dependencies --chown=app:app /app/apps/whatsapp-bridge/package.json ./apps/whatsapp-bridge/package.json
COPY --from=builder --chown=app:app /app/apps/whatsapp-bridge/dist ./apps/whatsapp-bridge/dist
RUN mkdir -p /data/session && chown -R app:app /data
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 CMD wget --spider --quiet http://127.0.0.1:3020/health || exit 1
CMD ["node", "apps/whatsapp-bridge/dist/index.js"]
