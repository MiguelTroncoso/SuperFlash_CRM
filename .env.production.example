NODE_ENV=production

API_PORT=3001
POSTGRES_DB=superflash
POSTGRES_USER=superflash
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://superflash:replace-with-a-long-random-password@postgres:5432/superflash?schema=public
REDIS_URL=redis://redis:6379

WEB_URL=https://app.superflash.site
NEXT_PUBLIC_API_URL=https://api.superflash.site

JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
SWAGGER_ENABLED=false
DEFAULT_TIMEZONE=America/Santiago
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-unique-key-of-at-least-32-characters
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_WEBHOOK_PUBLIC_URL=https://api.superflash.site/api/v1/integrations/whatsapp/webhook

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-a-strong-owner-password
SEED_OWNER_FIRST_NAME=Owner
SEED_OWNER_LAST_NAME=SuperFlash
SEED_CATALOG_EXAMPLES=false
