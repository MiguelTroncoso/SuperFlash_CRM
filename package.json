{
  "name": "@superflash/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "build:utils": "npm run build --workspace=@superflash/utils",
    "build:web": "npm run build:utils && npm run build --workspace=@superflash/web",
    "build:api": "npm run build:utils && npm run build --workspace=@superflash/api",
    "build:bridge": "npm run build --workspace=@superflash/whatsapp-bridge",
    "db:generate": "npm run prisma:generate --workspace=@superflash/api",
    "db:migrate": "npm run prisma:migrate --workspace=@superflash/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@superflash/api",
    "db:seed": "npm run prisma:seed --workspace=@superflash/api",
    "db:validate": "npm run prisma:validate --workspace=@superflash/api",
    "db:verify-integrity": "npm run prisma:verify-integrity --workspace=@superflash/api",
    "db:refresh-revenue-views": "npm run prisma:refresh-revenue-views --workspace=@superflash/api",
    "test": "npm run test --workspace=@superflash/api",
    "test:unit": "npm run build:utils && npm run test:unit --workspace=@superflash/api",
    "test:integration": "npm run build:utils && npm run test:integration --workspace=@superflash/api",
    "test:web": "npm run build:utils && npm run test --workspace=@superflash/web",
    "test:bridge": "npm run test --workspace=@superflash/whatsapp-bridge",
    "dev:api": "npm run build:utils && npm run start:dev --workspace=@superflash/api",
    "dev:web": "npm run build:utils && npm run dev --workspace=@superflash/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "typecheck": "npm run build:utils && npm run typecheck --workspaces --if-present"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
